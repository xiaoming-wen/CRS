# 主业务库（竞赛、files、users 等）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/competition_user?charset=utf8mb4

# 第二套登录/注册（alt_auth）
ALT_AUTH_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/competition_alt_auth?charset=utf8mb4
ALT_AUTH_SECRET_KEY=change-me-in-production
ALT_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 多媒体转换元数据库（可选）
CONVERT_URL_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/competition_videos?charset=utf8mb4

# API 时间字段展示时区
API_RESPONSE_DATETIME_TZ=Asia/Shanghai

# CORS 白名单（逗号分隔，禁止 *；与 allow_credentials=true 同用）
# 不配置时默认：https://www.damoxingcr.cn,https://damoxingcr.cn
CORS_ALLOW_ORIGINS=https://www.damoxingcr.cn,https://damoxingcr.cn
# 本地联调时设为 true，额外允许 localhost:8002/8003/8080
CORS_ALLOW_LOCALHOST=false

# 阿里云短信（注册验证码）——请勿把密钥提交到仓库
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 模板变量名，默认 code（模板内容如：您的验证码为${code}）
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_REGION_ID=cn-hangzhou
# 调试：true 时配置不全也可发码，并在接口返回 debug_code（生产务必 false）
ALIYUN_SMS_DEBUG=false
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_INTERVAL_SECONDS=60

# 若需临时切回 SQLite，可改为：
# DATABASE_URL=sqlite:///./user_management.db
# ALT_AUTH_DATABASE_URL=sqlite:///./alt_auth.db
